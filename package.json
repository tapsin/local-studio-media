{
  "name": "local-studio-media",
  "version": "1.0.0",
  "description": "LM Studio OpenAI-compatible image and video generation desktop client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage --win nsis",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.localstudio.media",
    "productName": "Local Studio Media",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "linux": { "target": ["AppImage"], "category": "Graphics" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
